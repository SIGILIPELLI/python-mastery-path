<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vremployee.trading-weekly-tuning</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__VREMPLOYEE_DIR__/trading-ops/weekly_tuning.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>18</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/trading-weekly-tuning.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/trading-weekly-tuning.log</string>
</dict>
</plist>
