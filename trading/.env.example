# ---- Encryption (REQUIRED) -------------------------------------------------
# 32-byte urlsafe base64 key. Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
VAULT_KEY=

# ---- Paytm Money credentials (entered ONCE, then stored encrypted) ---------
# Leave blank here and POST them to /auth/onboard instead if you prefer.
PAYTM_API_KEY=
PAYTM_API_SECRET=
PAYTM_LOGIN_ID=
PAYTM_PASSWORD=
PAYTM_TOTP_SECRET=

# ---- Runtime ---------------------------------------------------------------
DATABASE_URL=sqlite:///./data/trading.db
BROKER=paper          # paper | paytm
ADMIN_TOKEN=change-me # bearer token for the control API
DRY_RUN=true          # true = never send live orders, log intents only
UNIVERSE=RELIANCE,TCS,HDFCBANK,INFY,ICICIBANK
CAPITAL=100000
MAX_POSITION_PCT=0.15
MAX_DAILY_LOSS_PCT=0.03
MAX_OPEN_POSITIONS=5
